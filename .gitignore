# ===============================================
# CRITICAL: HEALTH DATA PROTECTION
# ===============================================
# NEVER commit health records or personal data!
data/
*.db
*.sqlite
*.sqlite3

# ===============================================
# PRIVATE DOCS
# ===============================================
docs/notes/PATENT_ANALYSIS.md
docs/notes/RESEARCH_IDEAS.md

# ===============================================
# CLAUDE CODE (local-only, per its own header)
# ===============================================
CLAUDE.md

# ===============================================
# EVAL HARNESS RESULTS (issue #29)
# ===============================================
# Local run output — not reproducible across machines/backends/model
# versions, so not worth tracking in git. The harness code itself is
# tracked; only its output isn't.
eval/results/*.json

# Exception: the 30-case human-vs-LLM-judge review study's own inputs/
# outputs are cited in the paper's Data Availability section (DEC-042) —
# these need to be publicly reproducible, unlike the general run output
# ignored above.
!eval/results/review_study_outputs.json
!eval/results/review_study_outputs_prefix_backup.json
!eval/results/review_study_outputs_postfix.json
!eval/results/judge_review_study_results.json
!eval/results/judge_review_study_results_prefix_backup.json
!eval/results/judge_review_study_results_postfix.json
!eval/results/judge_noise_check_review_study.json
!eval/results/review_study_outputs_singleshot.json
!eval/results/judge_review_study_results_singleshot.json
!eval/results/judge_noise_check_review_study_singleshot.json

